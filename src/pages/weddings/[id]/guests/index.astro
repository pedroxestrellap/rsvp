---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import GuestManager from "@/components/weddings/GuestManager.astro";
import { supabaseServer } from "@/lib/supabaseServer";
import { getPlannerWedding, isSameOrigin } from "@/lib/weddingAccessServer";
import { handleGuestAction } from "@/lib/guestManagementServer";
import { listGuestsWithRsvpByWedding } from "@/lib/guestsRsvpsServer";
import { guestFilters } from "@/lib/guestList";

const { id } = Astro.params;
if (!id) return new Response("Boda no encontrada", { status: 404 });
const access = await getPlannerWedding(supabaseServer(Astro), id);
if (!access) return new Response("Boda no encontrada", { status: 404 });
const { supabase, wedding } = access;
let errorMessage = "";
if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, Astro.url)) return new Response("Origen no permitido", { status: 403 });
  try {
    await handleGuestAction(supabase, id, await Astro.request.formData());
    const params=new URLSearchParams({saved:"1"});
    const filters=guestFilters(Astro.url.searchParams);
    if(filters.q)params.set("q",filters.q);
    if(filters.status!=="all")params.set("guest_status",filters.status);
    if(filters.companions!=="all")params.set("companions",filters.companions);
    return Astro.redirect(`/weddings/${id}/guests?${params}`, 303);
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : "No se pudo guardar el invitado.";
  }
}
const guests = await listGuestsWithRsvpByWedding(supabase, id);
---
<DashboardLayout title={`Invitados · ${wedding.title}`}>
  <div class="mx-auto max-w-5xl space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div><h1 class="text-2xl font-semibold text-slate-900">Invitados</h1><p class="mt-1 text-sm text-slate-500">{wedding.title}</p></div>
      <a href={`/weddings/${id}`} class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold">Volver a la boda</a>
    </div>
    {errorMessage && <p class="rounded-xl bg-red-50 p-4 text-sm text-red-700" data-page-error role="alert">{errorMessage}</p>}
    {Astro.url.searchParams.has("saved") && !errorMessage && <p class="rounded-xl bg-emerald-50 p-4 text-sm text-emerald-700" role="status">Cambios guardados.</p>}
    <GuestManager guests={guests} slug={wedding.slug} weddingId={id} weddingTitle={wedding.title} planner compact />
  </div>
</DashboardLayout>
