---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import WeddingEditor from "@/components/weddings/WeddingEditor.astro";
import WeddingLinks from "@/components/weddings/WeddingLinks.astro";
import { supabaseServer } from "@/lib/supabaseServer";
import { getPlannerWedding, isSameOrigin } from "@/lib/weddingAccessServer";
import { updateWedding, setWeddingPublished } from "@/lib/weddingsServer";
import { parseWeddingForm } from "@/lib/weddingSettings";

const { id } = Astro.params;
if (!id) return new Response("Boda no encontrada", { status: 404 });
const access = await getPlannerWedding(supabaseServer(Astro), id);
if (!access) return new Response("Boda no encontrada", { status: 404 });
const { supabase, wedding } = access;
let errorMessage = "";
if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, Astro.url)) return new Response("Origen no permitido", { status: 403 });
  try {
    const form = await Astro.request.formData();
    const action = String(form.get("action"));
    if (action === "save_wedding") await updateWedding(supabase, id, parseWeddingForm(form, wedding.settings ?? {}));
    else if (action === "publish" || action === "unpublish") await setWeddingPublished(supabase, id, action === "publish");
    else throw new Error("Acción no válida.");
    return Astro.redirect(`/weddings/${id}?saved=1`, 303);
  } catch (error) { errorMessage = error instanceof Error ? error.message : "No se pudo guardar la boda."; }
}
---
<DashboardLayout title={wedding.title ?? "Boda"}>
  <div class="mx-auto max-w-5xl space-y-6">
    <a href="/weddings" class="text-sm text-slate-500 underline">← Todas las bodas</a>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div><h1 class="text-2xl font-semibold text-slate-900">{wedding.title}</h1><p class="mt-1 text-sm text-slate-500">{wedding.is_published ? "Invitación publicada" : "Borrador"}</p></div>
      <form method="POST"><input type="hidden" name="action" value={wedding.is_published ? "unpublish" : "publish"} /><button class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white">{wedding.is_published ? "Despublicar" : "Publicar invitación"}</button></form>
    </div>
    {errorMessage && <p class="rounded-xl bg-red-50 p-4 text-sm text-red-700" role="alert">{errorMessage}</p>}
    {Astro.url.searchParams.has("saved") && !errorMessage && <p class="rounded-xl bg-emerald-50 p-4 text-sm text-emerald-700" role="status">Cambios guardados.</p>}
    <div class="grid gap-4 sm:grid-cols-2">
      <a href={`/weddings/${id}/guests`} class="rounded-2xl border border-slate-200 bg-white p-5 hover:bg-slate-50"><h2 class="font-semibold">Invitados y acompañantes →</h2><p class="mt-1 text-sm text-slate-500">Añadir, editar, eliminar y compartir invitaciones personales.</p></a>
      <a href={`/weddings/${id}/rsvps`} class="rounded-2xl border border-slate-200 bg-white p-5 hover:bg-slate-50"><h2 class="font-semibold">Confirmaciones RSVP →</h2><p class="mt-1 text-sm text-slate-500">Respuestas y personas confirmadas.</p></a>
    </div>
    <WeddingLinks wedding={wedding} />
    <a href={`/weddings/${id}/templates`} class="block rounded-2xl border border-slate-200 bg-white p-5 hover:bg-slate-50"><h2 class="font-semibold">Templates de invitación →</h2><p class="mt-1 text-sm text-slate-500">Elige y previsualiza el diseño que recibirán los invitados.</p></a>
    <WeddingEditor wedding={wedding} />
  </div>
</DashboardLayout>
