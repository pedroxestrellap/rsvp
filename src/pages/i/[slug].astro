---
import InvitationLayout from "@/layouts/InvitationLayout.astro";
import InvitationView from "@/components/invitations/InvitationView.astro";
import { weddingAdmin } from "@/lib/weddingAccessServer";
import { deadlinePassed } from "@/lib/rsvpSubmissionServer";
import { getInvitationGuest } from "@/lib/invitationGuestServer";
const { slug } = Astro.params;
const { data: wedding, error } = await weddingAdmin().from("weddings")
  .select("id, workspace_id, title, slug, event_date, rsvp_deadline, timezone, theme_id, settings, is_published, created_at")
  .eq("slug", slug).eq("is_published", true).maybeSingle();
if (error || !wedding) return new Response("Invitación no encontrada", { status: 404 });
Astro.response.headers.set("Referrer-Policy", "no-referrer");
const code = (Astro.url.searchParams.get("code") ?? "").trim();
const rsvpPath = `/i/${wedding.slug}/rsvp${code ? `?code=${encodeURIComponent(code)}` : ""}`;
const declinePath = `/i/${wedding.slug}/rsvp?status=declined${code ? `&code=${encodeURIComponent(code)}` : ""}`;
const personal = await getInvitationGuest(weddingAdmin(), wedding.id, code);
if (code && !personal) return new Response("El enlace de invitación no es válido. Solicita tu enlace personal a los novios.", { status: 404 });
Astro.response.headers.set("Cache-Control", "no-store");
---
<InvitationLayout weddingTitle={wedding.title} themeId={wedding.theme_id}>
  <InvitationView wedding={wedding} rsvpPath={rsvpPath} declinePath={declinePath} guest={personal?.guest} rsvp={{ code, companions: personal?.companions, initialStatus: personal?.initialStatus, closed: deadlinePassed(wedding) }} />
</InvitationLayout>
