---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResetPasswordForm from "@/components/dashboard/ResetPasswordForm";
---

<BaseLayout title="Cambiar contraseña - Planner">
  <main class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-sm bg-white border rounded p-6">
      <h1 class="text-xl font-bold">Cambiar contraseña</h1>
      <p class="text-sm opacity-70 mt-1">Elige una nueva contraseña para tu cuenta.</p>
      <ResetPasswordForm client:load />
    </div>
  </main>
</BaseLayout>
