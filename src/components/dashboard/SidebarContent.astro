---
import { isActivePath, weddingSection, weddingSectionPath } from "../../lib/nav";
import AdminIcon from "../ui/AdminIcon.astro";
const {currentPath="",workspace=null,mode="planner",couplePath="",activeTab="guests",expanded=false}=Astro.props;
const weddingId=currentPath.match(/^\/weddings\/([^/]+)/)?.[1];
const section=currentPath==="/weddings"?weddingSection(Astro.url.searchParams.get("section")):null;
const links=mode==="couple"?[
  {label:"Invitados",href:`${couplePath}?tab=guests`,icon:"users",tab:"guests",active:activeTab==="guests"},
  {label:"Información de la boda",href:`${couplePath}?tab=information`,icon:"calendar",tab:"information",active:activeTab==="information"},
  {label:"Formulario RSVP",href:`${couplePath}?tab=form`,icon:"mail",tab:"form",active:activeTab==="form"},
]:[
  {label:"Resumen",href:"/dashboard",icon:"home",active:isActivePath(currentPath,"/dashboard")},
  {label:"Bodas",href:"/weddings",icon:"calendar",active:(currentPath==="/weddings" && !section) || Boolean(weddingId && !/guests|templates/.test(currentPath))},
  {label:"Invitados",href:weddingSectionPath(currentPath,"guests"),icon:"users",active:currentPath.includes("/guests") || section==="guests"},
  {label:"Templates",href:weddingSectionPath(currentPath,"templates"),icon:"grid",active:currentPath.includes("/templates") || section==="templates"},
];
const initials=(workspace?.name || "Wedding Suite").split(/\s+/).slice(0,2).map((part:string)=>part[0]).join("");
---
<nav class:list={["admin-navigation",expanded && "admin-navigation-expanded"]} aria-label={mode==="couple"?"Nuestra boda":"Navegación principal"}>
  {links.map(link=><a href={link.href} aria-label={link.label} aria-current={link.active?"page":undefined} class:list={["admin-nav-link",link.active && "is-active"]} data-couple-nav={"tab" in link?link.tab:undefined}><AdminIcon name={link.icon} /><span class="admin-nav-label">{link.label}</span></a>)}
  <span class="admin-navigation-spacer"></span>
  <div class="admin-nav-avatar" aria-label={workspace?.name || "Wedding Suite"}>{initials}</div>
</nav>
