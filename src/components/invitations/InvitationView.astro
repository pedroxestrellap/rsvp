---
import type { WeddingRow } from "../../types/weddings";
import { getWeddingTemplate } from "../../lib/weddingTemplates";
import ClassicInvitation from "./ClassicInvitation.astro";
import FloralRomance from "./FloralRomance.astro";
import SedaPromesas from "./SedaPromesas.astro";
import type { InvitationGuest, InvitationRsvp } from "../../types/invitations";
interface Props {
  wedding: WeddingRow; rsvpPath: string; declinePath: string;
  guest?: InvitationGuest | null;
  rsvp?: InvitationRsvp;
}
const props = Astro.props;
const template = getWeddingTemplate(props.wedding.theme_id);
const views = { theme_1: ClassicInvitation, floral_romance: FloralRomance, seda_promesas: SedaPromesas };
const View = views[template.id];
---
{props.guest && <header class="invitation-recipient" data-invitation-recipient>
  <p>Una invitación especial para</p><p class="invitation-recipient-name">{props.guest.full_name}</p>
</header>}
<View {...props} />
