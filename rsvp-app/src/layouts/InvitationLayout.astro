---
import BaseLayout from "./BaseLayout.astro";
import { getWeddingTemplate } from "../lib/weddingTemplates";
import "../styles/invitations.css";
import "../styles/floral-romance.css";
import "@/styles/seda-promesas.css";

const { weddingTitle, themeId = "theme_1", form = false } = Astro.props;
const template = getWeddingTemplate(themeId);
---

<BaseLayout title={weddingTitle}>
  <Fragment slot="head">
    {["floral_romance", "seda_promesas"].includes(template.id) && <>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Pinyon+Script&display=swap" rel="stylesheet" />
    </>}
  </Fragment>
  <div class="invitation-shell" data-template={template.id}>
    <slot name="toolbar" />
    <main class:list={["invitation-page", form && "invitation-form-page"]}>
    <div class="invitation-content">
      <slot />
    </div>
    </main>
  </div>
</BaseLayout>
