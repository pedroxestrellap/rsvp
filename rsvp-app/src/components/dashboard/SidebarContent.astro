    <div class="grid grid-cols-3 gap-3 text-xs text-slate-500">
      <div>
        <div>Publicadas</div>
        <div class="mt-1 text-lg font-semibold text-slate-900">
          {sidebarStats?.published ?? 0}
        </div>
      </div>
      <div>
        <div>Borradores</div>
        <div class="mt-1 text-lg font-semibold text-slate-900">
          {sidebarStats?.drafts ?? 0}
        </div>
      </div>
      <div>
        <div>RSVP hoy</div>
        <div class="mt-1 text-lg font-semibold text-slate-900">
          {sidebarStats?.rsvpToday ?? 0}
        </div>
      </div>
    </div>
  </div> -->

