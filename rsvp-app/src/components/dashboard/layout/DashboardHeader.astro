---
import AdminIcon from "../../ui/AdminIcon.astro";
const {mode="planner",workspaceName="Wedding Suite"}=Astro.props;
---
<header class="admin-header"><div class="admin-header-identity"><button type="button" class="admin-icon-button admin-menu-trigger" data-open-admin-menu aria-label="Abrir menú" aria-haspopup="dialog"><AdminIcon name="grid" /></button><a href={mode==="couple"?"#admin-main":"/dashboard"} class="admin-wordmark">Wedding<span>Suite</span></a><span class="admin-header-section">{mode==="couple"?"Nuestra boda":"Planner"}</span></div><div class="admin-header-right"><span class="admin-header-date">{new Date().toLocaleDateString("es",{weekday:"long",day:"numeric",month:"long"})}</span><span class="admin-header-workspace">{workspaceName}</span></div></header>
