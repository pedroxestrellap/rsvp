---
const { currentPath = "" } = Astro.props;

const nav = [
  { href: "/dashboard", label: "Resumen" },
  { href: "/weddings", label: "Bodas" },
  { href: "/guests", label: "Invitados" },
  { href: "/settings", label: "Configuración" },
];

const isActive = (href: string) => {
  if (href === "/dashboard") return currentPath === "/dashboard";
  return currentPath.startsWith(href);
};
---

<aside class="hidden w-72 shrink-0 border-r border-slate-200 bg-white lg:block">
  <div class="flex h-full min-h-screen flex-col">
    <div class="px-6 py-6">
      <div class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-2xl bg-emerald-600 text-white">
          <span class="text-sm font-semibold">W</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Wedding Suite</p>
          <p class="text-xs text-slate-500">Planner Dashboard</p>
        </div>
      </div>

      <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
        <p class="text-xs text-slate-500">Workspace</p>
        <p class="mt-1 text-sm font-semibold text-slate-900">Mi Workspace</p>
        <p class="mt-1 text-xs text-slate-500">mi-workspace-f3ac9d</p>
      </div>
    </div>

    <nav class="px-4">
      <ul class="space-y-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition",
                isActive(item.href)
                  ? "bg-emerald-50 text-emerald-800"
                  : "text-slate-700 hover:bg-slate-50",
              ]}
            >
              <span
                class:list={[
                  "h-2.5 w-2.5 rounded-full",
                  isActive(item.href) ? "bg-emerald-500" : "bg-slate-300",
                ]}
              />
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto border-t border-slate-200 px-6 py-6">
      <a
        href="/weddings/new"
        class="block w-full rounded-xl bg-emerald-600 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-emerald-700"
      >
        + Nueva boda
      </a>

      <div class="mt-4 flex items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-slate-200"></div>
          <div>
            <p class="text-sm font-semibold text-slate-900">Tu cuenta</p>
            <p class="text-xs text-slate-500">Plan Free</p>
          </div>
        </div>

        <a
          href="/logout"
          class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
        >
          Salir
        </a>
      </div>
    </div>
  </div>
</aside>
