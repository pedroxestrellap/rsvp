---
import SidebarContent from "./SidebarContent.astro";
import AdminIcon from "../ui/AdminIcon.astro";
const props=Astro.props;
---
<dialog class="admin-mobile-menu" data-admin-menu aria-labelledby="admin-menu-title"><div class="admin-mobile-menu-heading"><h2 id="admin-menu-title">Wedding Suite</h2><button type="button" class="admin-icon-button" data-close-admin-menu aria-label="Cerrar menú"><AdminIcon name="close" /></button></div><SidebarContent {...props} expanded /></dialog>
<script>
  const menu=document.querySelector<HTMLDialogElement>("[data-admin-menu]");
  document.querySelectorAll("[data-open-admin-menu]").forEach(button=>button.addEventListener("click",()=>menu?.showModal()));
  menu?.querySelector("[data-close-admin-menu]")?.addEventListener("click",()=>menu.close());
  menu?.addEventListener("click",event=>{if((event.target as Element).closest("a"))menu.close();});
</script>
