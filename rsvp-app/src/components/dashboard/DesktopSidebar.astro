---
import SidebarContent from "./SidebarContent.astro";
import AdminIcon from "../ui/AdminIcon.astro";
const props=Astro.props;
---
<aside class="admin-desktop-sidebar">
  <a class="admin-brand-mark" href={props.mode==="couple"?props.couplePath:"/dashboard"} aria-label="Wedding Suite"><AdminIcon name="heart" /></a>
  <SidebarContent {...props} />
</aside>
