---
const stitches = Array.from({ length: 56 }, (_, i) => {
  const angle = i * Math.PI * 2 / 56;
  return { x: 200 + 165 * Math.sin(angle), y: 270 - 230 * Math.cos(angle), rotation: angle * 180 / Math.PI };
});
---
<svg class="floral-lace-frame" viewBox="0 0 400 540" fill="none" stroke="#FFFCF6" aria-hidden="true">
  <ellipse cx="200" cy="270" rx="149" ry="213" stroke-width="4" />
  <ellipse cx="200" cy="270" rx="155" ry="219" stroke-width="1.4" stroke-dasharray="2 3" />
  <ellipse cx="200" cy="270" rx="173" ry="239" stroke-width="2" />
  {stitches.map(({ x, y, rotation }) => <g transform={`translate(${x} ${y}) rotate(${rotation})`}>
    <path d="M-10 7C-28-8-20-30 0-29 20-30 28-8 10 7M-8 7C-17-5-13-21 0-22 13-21 17-5 8 7M0 9V-27M0 4-16-13M0 4 16-13M0 1-11-21M0 1 11-21" stroke-width="1.35" />
    <path d="M-17-21c-9-13 2-18 6-9M17-21c9-13-2-18-6-9" stroke-width="1.6" />
    <circle cy="-31" r="2" fill="#FFFCF6" stroke="none" />
    <circle cy="7" r="2.3" fill="#FFFCF6" stroke="none" />
  </g>)}
</svg>
