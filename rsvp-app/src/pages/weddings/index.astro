---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { supabaseServer } from "../../lib/supabaseServer";
import { listWeddingsByWorkspace, createWedding } from "../../lib/weddingsServer";

const supabase = supabaseServer(Astro);

const { data: memberships, error: mErr } = await supabase
  .from("workspace_users")
  .select("workspace_id, workspaces:workspace_id(id,name,slug)")
  .limit(1);

if (mErr) throw mErr;

const workspace = memberships?.[0]?.workspaces ?? null;
const workspaceId = memberships?.[0]?.workspace_id ?? null;

if (!workspaceId) throw new Error("No workspace");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const title = String(form.get("title") ?? "").trim();
  const event_date = String(form.get("event_date") ?? "").trim();

  const newId = await createWedding(supabase, workspaceId, {
    title: title || "Nueva boda",
    event_date: event_date || null,
    settings: {},
  });

  return Astro.redirect(`/weddings/${newId}`);
}

const weddings = await listWeddingsByWorkspace(supabase, workspaceId);
---

<DashboardLayout title="Bodas">
  <div class="mx-auto max-w-6xl px-6 py-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold text-slate-900">Bodas</h1>
        <p class="mt-1 text-sm text-slate-500">Crea y gestiona bodas dentro de tu workspace.</p>
      </div>

      <form method="POST" class="flex flex-wrap items-end gap-2 rounded-2xl border border-slate-200 bg-white p-4">
        <div>
          <label class="text-xs text-slate-500">Título</label>
          <input name="title" class="mt-1 w-56 rounded-xl border border-slate-200 px-3 py-2 text-sm" placeholder="Boda de Ana & Luis" />
        </div>
        <div>
          <label class="text-xs text-slate-500">Fecha</label>
          <input name="event_date" type="date" class="mt-1 rounded-xl border border-slate-200 px-3 py-2 text-sm" />
        </div>
        <button class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
          + Nueva boda
        </button>
      </form>
    </div>

    <div class="mt-6 grid gap-4">
      {weddings.length === 0 ? (
        <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center text-slate-600">
          Aún no tienes bodas. Crea tu primera boda arriba.
        </div>
      ) : (
        weddings.map((w) => (
          <a
            href={`/weddings/${w.id}`}
            class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:bg-slate-50"
          >
            <div class="flex items-center justify-between gap-4">
              <div>
                <div class="text-sm font-semibold text-slate-900">{w.title ?? "Boda sin título"}</div>
                <div class="mt-1 text-xs text-slate-500">
                  {w.slug ? `slug: ${w.slug}` : "slug: —"} • {w.event_date ? `fecha: ${w.event_date}` : "fecha: —"}
                </div>
              </div>

              <span class={`rounded-full border px-3 py-1 text-xs ${
                w.is_published ? "bg-emerald-50 text-emerald-700 border-emerald-100" : "bg-slate-50 text-slate-600 border-slate-200"
              }`}>
                {w.is_published ? "Publicada" : "Borrador"}
              </span>
            </div>
          </a>
        ))
      )}
    </div>
  </div>
</DashboardLayout>
