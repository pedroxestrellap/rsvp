---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { supabaseServer } from "@/lib/supabaseServer";
import { getPlannerWedding, isSameOrigin } from "@/lib/weddingAccessServer";
import { updateWedding } from "@/lib/weddingsServer";
import { weddingTemplates, findWeddingTemplate, getWeddingTemplate } from "@/lib/weddingTemplates";
const { id } = Astro.params;
if (!id) return new Response("Boda no encontrada", { status: 404 });
const access = await getPlannerWedding(supabaseServer(Astro), id);
if (!access) return new Response("Boda no encontrada", { status: 404 });
const { wedding, supabase } = access;
let errorMessage = "";
if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, Astro.url)) return new Response("Origen no permitido", { status: 403 });
  try {
    const form = await Astro.request.formData();
    const template = findWeddingTemplate(String(form.get("theme_id") ?? ""));
    if (!template) throw new Error("Selecciona un template disponible.");
    await updateWedding(supabase, wedding.id, { theme_id: template.id });
    return Astro.redirect(`/weddings/${id}/templates?saved=1`, 303);
  } catch (error) { errorMessage = error instanceof Error ? error.message : "No se pudo activar el template."; }
}
const selected = getWeddingTemplate(wedding.theme_id);
---
<DashboardLayout title={`Templates · ${wedding.title}`}>
  <div class="mx-auto max-w-6xl space-y-7">
    <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Ruta de navegación"><a href="/weddings" class="hover:text-emerald-700">Bodas</a><span>/</span><a href={`/weddings/${id}`} class="truncate hover:text-emerald-700">{wedding.title}</a><span>/</span><span class="text-slate-800">Templates</span></nav>
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div><p class="text-xs font-semibold uppercase tracking-[.18em] text-emerald-700">El diseño de vuestra historia</p><h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Biblioteca de templates</h1><p class="mt-3 max-w-2xl text-sm leading-6 text-slate-500">Encuentra la invitación que mejor os representa. Cada diseño se adapta a los detalles de <strong class="font-medium text-slate-700">{wedding.title}</strong>.</p></div>
      <a href={`/weddings/${id}`} class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600">Volver a la boda</a>
    </header>
    {errorMessage && <p class="rounded-xl bg-red-50 p-4 text-sm text-red-700" role="alert">{errorMessage}</p>}
    {Astro.url.searchParams.has("saved") && !errorMessage && <p class="rounded-xl bg-emerald-50 p-4 text-sm text-emerald-700" role="status">El diseño de la invitación se ha actualizado.</p>}
    <section class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-emerald-100 bg-emerald-50/60 p-5">
      <div><p class="text-xs text-emerald-700">Diseño actual de la invitación</p><h2 class="mt-1 font-semibold text-slate-900">{selected.name}</h2><p class="mt-1 text-xs text-slate-500">{wedding.is_published ? "Se muestra en la invitación publicada." : "La boda sigue en borrador. Puedes previsualizarla antes de publicar."}</p></div>
      <a href={`/weddings/${id}/templates/preview/${selected.id}`} class="text-sm font-semibold text-emerald-800 underline underline-offset-4">Ver invitación →</a>
    </section>
    <div class="flex items-center justify-between border-b border-slate-200 pb-3"><h2 class="text-sm font-semibold text-slate-900">Todos los diseños <span class="ml-2 rounded-full bg-slate-200/70 px-2 py-0.5 text-xs text-slate-600">{weddingTemplates.length}</span></h2><span class="text-xs text-slate-500">Diseñados para móvil y escritorio</span></div>
    <div class="grid gap-6 md:grid-cols-2">
      {weddingTemplates.map(template => <article class:list={["overflow-hidden rounded-2xl border bg-white shadow-sm transition-shadow hover:shadow-md", selected.id === template.id ? "border-emerald-500 ring-1 ring-emerald-500" : "border-slate-200"]} data-template-card={template.id}>
        <a href={`/weddings/${id}/templates/preview/${template.id}`} class="group relative block overflow-hidden border-b border-slate-100 bg-slate-100" aria-label={`Vista previa de ${template.name}`}>
          <img src={template.thumbnail} alt={`Diseño de la invitación ${template.name}`} width="720" height="540" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]" />
          {selected.id === template.id && <span class="absolute left-4 top-4 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-emerald-700 shadow-sm">✓ Seleccionado</span>}
          <span class="absolute bottom-4 right-4 rounded-full bg-white/95 px-3 py-1.5 text-xs text-slate-600 shadow-sm">{template.style}</span>
        </a>
        <div class="p-6"><p class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{template.eyebrow}</p><div class="mt-2 flex flex-wrap items-center justify-between gap-3"><h3 class="text-xl font-semibold text-slate-900">{template.name}</h3><div class="flex gap-1.5" aria-label="Paleta del template">{template.colors.map(color => <span class="h-4 w-4 rounded-full border border-black/5" style={`background:${color}`} title={color}></span>)}</div></div><p class="mt-3 min-h-12 text-sm leading-6 text-slate-500">{template.description}</p>
          <div class="mt-6 flex flex-wrap items-center gap-3"><a href={`/weddings/${id}/templates/preview/${template.id}`} class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Vista previa</a><form method="POST"><input type="hidden" name="theme_id" value={template.id} /><button disabled={selected.id === template.id} class="rounded-xl bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800 disabled:bg-slate-100 disabled:text-slate-400">{selected.id === template.id ? "Template activo" : "Usar template"}</button></form></div>
        </div>
      </article>)}
    </div>
    <p class="text-xs leading-6 text-slate-500">El template personaliza la invitación y su formulario para los invitados. Los datos y las respuestas de la boda se conservan al cambiar de diseño.</p>
  </div>
</DashboardLayout>
