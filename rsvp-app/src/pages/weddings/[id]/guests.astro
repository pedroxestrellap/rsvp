---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { supabaseServer } from "../../../lib/supabaseServer";
import { listGuestsByWedding, createGuest } from "../../../modules/guests";

const supabase = supabaseServer(Astro);
const { id } = Astro.params;
if (!id) throw new Error("Missing wedding id");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");

  if (action === "create") {
    const full_name = String(form.get("full_name") ?? "").trim();
    await createGuest(supabase, { wedding_id: id, full_name: full_name || null });
  }

  return Astro.redirect(`/weddings/${id}/guests`);
}

const guests = await listGuestsByWedding(supabase, id);
---
<DashboardLayout title="Invitados">
  <div class="mx-auto max-w-4xl px-6 py-6">
    <h1 class="text-xl font-semibold text-slate-900">Invitados</h1>

    <form method="POST" class="mt-4 flex gap-2">
      <input type="hidden" name="action" value="create" />
      <input name="full_name" placeholder="Nombre completo" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" />
      <button class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white">Agregar</button>
    </form>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4">
      {guests.length === 0 ? (
        <p class="text-sm text-slate-500">No hay invitados todavía.</p>
      ) : (
        <ul class="divide-y">
          {guests.map((g) => (
            <li class="py-3 text-sm">
              <span class="font-medium">{g.full_name ?? "—"}</span>
              <span class="ml-2 text-slate-400">{g.invite_code ? `(${g.invite_code})` : ""}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</DashboardLayout>
