---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import { supabaseServer } from "../../../../lib/supabaseServer";
import { getGuestWithRsvp, getGuestGroup } from "../../../../lib/guestsServer";
import { upsertRsvpForGuest } from "../../../../lib/rsvpsServer";

const supabase = supabaseServer(Astro);
const { id, guestId } = Astro.params;

if (!id) throw new Error("Missing wedding id");
if (!guestId) throw new Error("Missing guestId");

let guest = await getGuestWithRsvp(supabase, guestId);
if (!guest) throw new Error("Guest not found");

// seguridad simple: que el guest pertenezca a la boda
if (guest.wedding_id !== id) throw new Error("Guest not in this wedding");

let group = await getGuestGroup(supabase, guest);

const currentRsvp = Array.isArray(guest.rsvps) ? guest.rsvps[0] : null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");

  if (action === "save_rsvp") {
    const status = String(form.get("status") ?? "pending");

    const seatsRaw = String(form.get("seats_confirmed") ?? "").trim();
    const seats_confirmed =
      seatsRaw === "" ? null : Number.isNaN(Number(seatsRaw)) ? null : Number(seatsRaw);

    await upsertRsvpForGuest(supabase, guestId, { status, seats_confirmed });

    return Astro.redirect(`/weddings/${id}/guests/${guestId}`);
  }
}

guest = await getGuestWithRsvp(supabase, guestId);
group = await getGuestGroup(supabase, guest);
---

<DashboardLayout title="Invitado">
  <div class="mx-auto max-w-4xl px-6 py-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold text-slate-900">{guest.full_name}</h1>
        <p class="mt-1 text-sm text-slate-500">
          Max seats: {guest.max_seats ?? "—"} · Invite code: {guest.invite_code ?? "—"}
        </p>
      </div>

      <a
        href={`/weddings/${id}/guests`}
        class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
      >
        Volver
      </a>
    </div>

    <!-- RSVP Card -->
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">RSVP</h2>
      <p class="mt-1 text-sm text-slate-500">Edita status y seats_confirmed.</p>

      <form method="POST" class="mt-4 grid gap-4">
        <input type="hidden" name="action" value="save_rsvp" />

        <div>
          <label class="text-xs text-slate-500">Status</label>
          <select name="status" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm">
            <option value="pending" selected={(currentRsvp?.status ?? "pending") === "pending"}>Pendiente</option>
            <option value="confirmed" selected={currentRsvp?.status === "confirmed"}>Confirmado</option>
            <option value="declined" selected={currentRsvp?.status === "declined"}>No asiste</option>
          </select>
        </div>

        <div>
          <label class="text-xs text-slate-500">
            Seats confirmed (máx. {guest.max_seats ?? "—"})
          </label>
          <input
            name="seats_confirmed"
            type="number"
            min="0"
            max={guest.max_seats ?? undefined}
            value={typeof currentRsvp?.seats_confirmed === "number" ? String(currentRsvp.seats_confirmed) : ""}
            class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm"
          />
        </div>

        <button class="mt-2 w-full rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
          Guardar
        </button>
      </form>
    </div>

    <!-- Grupo -->
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">Grupo</h2>
      <p class="mt-1 text-sm text-slate-500">Miembros asociados a este invitado.</p>

      <div class="mt-4 grid gap-2">
        {group.map((g) => (
          <a
            href={`/weddings/${id}/guests/${g.id}`}
            class={`flex items-center justify-between rounded-xl border px-4 py-3 hover:bg-slate-50 ${
              g.id === guest.id ? "border-emerald-200 bg-emerald-50/40" : "border-slate-200 bg-white"
            }`}
          >
            <div>
              <div class="text-sm font-semibold text-slate-900">{g.full_name}</div>
              <div class="mt-1 text-xs text-slate-500">
                {g.is_primary ? "Primary" : "Acompañante"} · Max seats: {g.max_seats ?? "—"}
              </div>
            </div>
            <span class="text-xs font-semibold text-slate-500">Ver →</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</DashboardLayout>
