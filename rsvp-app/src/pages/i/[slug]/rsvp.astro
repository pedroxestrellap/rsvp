---
import InvitationLayout from "@/layouts/InvitationLayout.astro";
import RsvpForm from "@/components/invitations/RsvpForm.astro";
import { weddingAdmin } from "@/lib/weddingAccessServer";
import { deadlinePassed } from "@/lib/rsvpSubmissionServer";
import { getInvitationGuest } from "@/lib/invitationGuestServer";
const supabase = weddingAdmin();
const { slug } = Astro.params;
const code = (Astro.url.searchParams.get("code") ?? "").trim();
const { data: wedding } = await supabase.from("weddings").select("id, title, slug, theme_id, settings, rsvp_deadline, timezone")
  .eq("slug", slug).eq("is_published", true).maybeSingle();
if (!wedding) return new Response("Invitación no encontrada", { status: 404 });
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
const personal = await getInvitationGuest(supabase, wedding.id, code);
if (code && !personal) return new Response("El enlace de invitación no es válido. Solicita tu enlace personal a los novios.", { status: 404 });
const initialStatus = Astro.url.searchParams.get("status") === "declined" ? "declined" : personal?.initialStatus;
const backPath = `/i/${wedding.slug}${code ? `?code=${encodeURIComponent(code)}` : ""}`;
---
<InvitationLayout weddingTitle={`Confirmar asistencia · ${wedding.title}`} themeId={wedding.theme_id} form>
  <RsvpForm wedding={wedding} guest={personal?.guest} code={code} companions={personal?.companions} initialStatus={initialStatus} closed={deadlinePassed(wedding)} backPath={backPath} />
</InvitationLayout>
